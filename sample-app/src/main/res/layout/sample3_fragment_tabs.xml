<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <dev.oneuiproject.oneui.widget.NavigationPageContainer
        android:id="@+id/nav_pages" android:layout_width="match_parent"
        android:layout_height="match_parent" android:paddingBottom="88dp">
        <FrameLayout android:id="@id/nav_grid" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <FrameLayout android:id="@id/nav_list" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" />
        <FrameLayout android:id="@id/nav_cards" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" />
        <androidx.core.widget.NestedScrollView android:id="@id/nav_settings"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Navigation settings" />
                <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_marginHorizontal="16dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/oui_background_color" android:orientation="vertical"
                    android:paddingHorizontal="24dp" android:paddingVertical="12dp">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/nav_toggle_blur" android:layout_width="match_parent"
                        android:layout_height="52dp" android:checked="true" android:text="Blur" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/nav_toggle_animations" android:layout_width="match_parent"
                        android:layout_height="52dp" android:checked="true" android:text="Animations" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/nav_toggle_swipe" android:layout_width="match_parent"
                        android:layout_height="52dp" android:checked="true" android:text="Swipe between pages" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/nav_toggle_search" android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="Search extra" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Display" android:textSize="14sp" />
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/nav_display_mode" android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </dev.oneuiproject.oneui.widget.RoundLinearLayout>
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="How navigation works" />
                <dev.oneuiproject.oneui.widget.RoundLinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp" android:background="@color/oui_background_color"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Each destination is linked to a page with the same ID. Tap the sticky bar or swipe horizontally to change pages. Grid, List and Cards are empty for future examples. Menu opens the actions popup, while the optional search button sits outside the destination pill."
                        android:textSize="14sp" />
                </dev.oneuiproject.oneui.widget.RoundLinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </dev.oneuiproject.oneui.widget.NavigationPageContainer>
    <dev.oneuiproject.oneui.widget.FloatingNavigationBar
        android:id="@+id/tabs_floating_nav" android:layout_width="wrap_content"
        android:layout_height="58dp" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp"
        app:navigationMenu="@menu/sample_floating_navigation"
        app:showLabels="true" app:blurEnabled="true" />
</FrameLayout>
