<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <dev.oneuiproject.oneui.widget.NavigationPageContainer
        android:id="@+id/toolbar_pages" android:layout_width="match_parent"
        android:layout_height="match_parent" android:paddingBottom="88dp">
        <androidx.core.widget.NestedScrollView android:id="@id/toolbar_page"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Floating toolbar" />
                <dev.oneuiproject.oneui.widget.RoundLinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp" android:background="@color/oui_background_color"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="The toolbar holds up to five actions. Each icon and label has its own callback. Open it to replace the bottom navigation bar, then close it to switch pages again."
                        android:textSize="14sp" />
                </dev.oneuiproject.oneui.widget.RoundLinearLayout>
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Try it" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/open_toolbar_button" style="@style/OneUI.ButtonStyleColored"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:text="Open toolbar" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/toolbar_animations" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp" android:checked="true"
                    android:text="Animations" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView android:id="@id/action_bar_page"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Action bar" />
                <dev.oneuiproject.oneui.widget.RoundLinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp" android:background="@color/oui_background_color"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Use a two-action bar for a focused task such as Cancel and Save. It opens in the same sticky bottom position as navigation."
                        android:textSize="14sp" />
                </dev.oneuiproject.oneui.widget.RoundLinearLayout>
                <dev.oneuiproject.oneui.widget.Separator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Try it" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/open_action_bar_button" style="@style/OneUI.ButtonStyleColored"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:text="Open action bar" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </dev.oneuiproject.oneui.widget.NavigationPageContainer>
    <dev.oneuiproject.oneui.widget.FloatingBarSwitcher
        android:id="@+id/toolbar_switcher" android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="16dp">
        <dev.oneuiproject.oneui.widget.FloatingNavigationBar
              android:id="@+id/toolbar_bottom_nav" android:layout_width="wrap_content"
              android:layout_height="60dp" android:layout_gravity="center"
            app:navigationMenu="@menu/sample_toolbar_pages"
            app:blurEnabled="true" />
        <dev.oneuiproject.oneui.widget.FloatingToolbar
            android:id="@+id/floating_toolbar" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone"
            app:toolbarMenu="@menu/sample_floating_toolbar" />
        <dev.oneuiproject.oneui.widget.FloatingActionBar
            android:id="@+id/floating_action_bar" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" />
    </dev.oneuiproject.oneui.widget.FloatingBarSwitcher>
</FrameLayout>
